---
// Espresso status badge (docs/plans/02-design.md §2.3): colour, text and icon.
// The icon is decorative (aria-hidden); screen readers read the text.
import { METHOD_LABELS, type Lang } from '../lib/codes.ts';
import { iconSvg, STATUS_SHORT, type EspressoStatus } from '../lib/icons.ts';

interface Props {
  lang: Lang;
  status: EspressoStatus;
}

const { lang, status } = Astro.props;
---
<span class={`badge badge-${status}`} data-status={status} data-method={status} title={METHOD_LABELS[status][lang]}>
  <Fragment set:html={iconSvg(status)} />
  <span class="badge-text">{STATUS_SHORT[status][lang]}</span>
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    border: 1px solid transparent;
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: 1.4;
  }
  .badge :global(.badge-icon) { flex: none; }
  .badge-espresso_semi {
    background: var(--status-semi-bg);
    color: var(--status-semi-text);
  }
  .badge-espresso_auto {
    background: var(--status-auto-bg);
    color: var(--status-auto-text);
    border-color: var(--status-auto-border);
  }
  .badge-espresso_none {
    background: var(--status-none-bg);
    color: var(--status-none-text);
    font-weight: 600;
  }
</style>
