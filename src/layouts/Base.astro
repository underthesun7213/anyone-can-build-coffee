---
import '../styles/tokens.css';
import '../styles/base.css';
import type { Lang } from '../lib/codes.ts';
import { langPath, LANG_STORAGE_KEY, withBase } from '../lib/lang.ts';
import { loadSiteData } from '../lib/load-data.ts';
import { t } from '../i18n/strings.ts';

interface Props {
  lang: Lang;
  title: string;
  /** Path after the language segment, e.g. "" for the list or "cafe/x/" for a cafe. */
  rest: string;
}

const { lang, title, rest } = Astro.props;
const base = import.meta.env.BASE_URL;
const other: Lang = lang === 'en' ? 'ja' : 'en';
const { lastUpdated } = loadSiteData();
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {t(lang, 'siteName')}</title>
    <link rel="alternate" hreflang={other} href={langPath(base, other, rest)} />
  </head>
  <body data-lang={lang}>
    <header class="site-header">
      <div class="page header-inner">
        <a class="site-name tap" href={withBase(base, `${lang}/`)}>{t(lang, 'siteName')}</a>
        <a class="lang-switch tap button" href={langPath(base, other, rest)} hreflang={other} lang={other} data-lang-switch={other}>{t(lang, 'switchTo')}</a>
      </div>
    </header>
    <div class="page">
      <p class="notice">{t(lang, 'sampleNotice')}</p>
      <main>
        <slot />
      </main>
      <footer class="site-footer muted">
        {t(lang, 'dataUpdated', { date: lastUpdated })}
      </footer>
    </div>
    <script is:inline define:vars={{ key: LANG_STORAGE_KEY, lang }}>
      // Remember the language last used, for the root redirect (PRD v0.6 §10).
      try { localStorage.setItem(key, lang); } catch {}
    </script>
  </body>
</html>

<style>
  .site-header {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
  }
  .lang-switch {
    flex: none;
    white-space: nowrap;
  }
  .site-name {
    justify-content: flex-start;
    padding-left: 0;
    color: var(--text);
    font-weight: 800;
    text-decoration: none;
  }
  .notice {
    margin: var(--space-4) 0 0;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius);
    background: var(--status-none-bg);
    color: var(--status-none-text);
    font-size: var(--text-sm);
  }
  .site-footer {
    margin-top: var(--space-8);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
  }
</style>
