---
import '../styles/tokens.css';
import '../styles/base.css';
import { langPath } from '../lib/lang.ts';
import { t } from '../i18n/strings.ts';

const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t('en', 'notFoundTitle')} · {t('ja', 'notFoundTitle')}</title>
  </head>
  <body>
    <main class="page">
    <h1>{t('en', 'notFoundTitle')}</h1>
    <p><a href={langPath(base, 'en', '')} hreflang="en">{t('en', 'backToList')}</a></p>
    <h1 lang="ja">{t('ja', 'notFoundTitle')}</h1>
    <p lang="ja"><a href={langPath(base, 'ja', '')} hreflang="ja">{t('ja', 'backToList')}</a></p>
    </main>
  </body>
</html>
