---
import Base from '../../layouts/Base.astro';
import CafeCard from '../../components/CafeCard.astro';
import { LANGS, type Lang } from '../../lib/codes.ts';
import { loadSiteData } from '../../lib/load-data.ts';
import { withBase } from '../../lib/lang.ts';
import { t } from '../../i18n/strings.ts';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const base = import.meta.env.BASE_URL;
const { cafes, chains, stations } = loadSiteData();
const chainById = new Map(chains.map((c) => [c.id, c]));
const stationById = new Map(stations.map((s) => [s.id, s]));
// Closed and moved cafes are handled in a later plan; the list shows active ones.
const listed = cafes
  .filter((c) => c.status === 'active')
  .sort((a, b) => a.stationId.localeCompare(b.stationId) || a.id.localeCompare(b.id));
---
<Base lang={lang} title={t(lang, 'listTitle')} rest="">
  <h1>{t(lang, 'listTitle')}</h1>
  <p>{t(lang, 'tagline')}</p>
  <p class="muted">{t(lang, 'cafeCount', { n: listed.length })}</p>
  <ol class="cafe-list">
    {listed.map((cafe) => (
      <li>
        <CafeCard
          lang={lang}
          cafe={cafe}
          href={withBase(base, `${lang}/cafe/${cafe.id}/`)}
          stationName={stationById.get(cafe.stationId)?.name[lang] ?? ''}
          stationLabel={t(lang, 'station')}
          chainNote={cafe.chainId ? chainById.get(cafe.chainId)?.note[lang] : undefined}
        />
      </li>
    ))}
  </ol>
</Base>

<style>
  .cafe-list {
    display: grid;
    gap: var(--space-3);
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
  }
</style>
