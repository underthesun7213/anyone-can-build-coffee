---
import Base from '../../layouts/Base.astro';
import MethodList from '../../components/MethodList.astro';
import { LANGS, type Lang } from '../../lib/codes.ts';
import { espressoMethods, loadSiteData, otherMethods } from '../../lib/load-data.ts';
import { withBase } from '../../lib/lang.ts';
import { t } from '../../i18n/strings.ts';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const base = import.meta.env.BASE_URL;
const { cafes, stations } = loadSiteData();
const stationById = new Map(stations.map((s) => [s.id, s]));
// Closed and moved cafes are handled in a later plan; the list shows active ones.
const listed = cafes
  .filter((c) => c.status === 'active')
  .sort((a, b) => a.stationId.localeCompare(b.stationId) || a.id.localeCompare(b.id));
---
<Base lang={lang} title={t(lang, 'listTitle')} rest="">
  <h1>{t(lang, 'listTitle')}</h1>
  <p>{t(lang, 'tagline')}</p>
  <p>{t(lang, 'cafeCount', { n: listed.length })}</p>
  <ol class="cafe-list">
    {listed.map((cafe) => (
      <li class="cafe-card" data-cafe-id={cafe.id}>
        <h2><a href={withBase(base, `${lang}/cafe/${cafe.id}/`)}>{cafe.name[lang]}</a></h2>
        <MethodList lang={lang} methods={espressoMethods(cafe)} kind="espresso" />
        <MethodList lang={lang} methods={otherMethods(cafe).slice(0, 2)} kind="other" />
        <p>{t(lang, 'station')}: {stationById.get(cafe.stationId)?.name[lang]}</p>
      </li>
    ))}
  </ol>
</Base>
