---
import { langPath } from '../lib/lang.ts';
import { t } from '../i18n/strings.ts';

const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t('en', 'siteName')} · {t('ja', 'siteName')}</title>
  </head>
  <body data-base={base}>
    <p>
      <a href={langPath(base, 'en', '')} hreflang="en">English</a> ·
      <a href={langPath(base, 'ja', '')} hreflang="ja" lang="ja">日本語</a>
    </p>
    <script>
      // Go to the language chosen last; otherwise follow the browser (PRD v0.6 §10).
      import { langPath, LANG_STORAGE_KEY, pickLanguage } from '../lib/lang.ts';
      let stored: string | null = null;
      try { stored = localStorage.getItem(LANG_STORAGE_KEY); } catch {}
      const lang = pickLanguage(stored, navigator.languages ?? [navigator.language]);
      location.replace(langPath(document.body.dataset.base ?? '/', lang, ''));
    </script>
  </body>
</html>
